# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit it.

# Absolute path to the SQLite database.
# Default: vesign.db in the project root.
# DB_PATH=/Users/you/PycharmProjects/Vesign/vesign.db

# Comma-separated origins allowed by CORS (dev only; not needed in production
# when the frontend is served by FastAPI itself).
# CORS_ORIGINS=http://localhost:3000

# Local development only — when set to 1, get_current_user returns a fixed dev
# user instead of verifying the Clerk JWT. Never set on production.
# BYPASS_AUTH=1
